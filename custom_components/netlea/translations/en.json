          "code": "短信验证码"
        }
      }
    },
    "error": {
      "invalid_auth": "账号或 token 无效",
      "cannot_connect": "无法连接尼特利服务器",
      "sms_failed": "验证码发送失败，请稍后再试",
      "no_credentials": "请填写手机号，或粘贴已有 token"
    },
    "abort": {
      "already_configured": "该账号已配置"
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "轮询设置",
        "data": {
          "scan_interval": "刷新间隔（秒）",
          "user_id": "userId（可选）",
