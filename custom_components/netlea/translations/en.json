        },
        "description": "lampMode 决定 HA 下发的指令如何被设备执行。默认「自动」= 沿用设备当前模式，不改动你的行程设置。"
      }
    }
  },
  "services": {
    "send_frame": {
      "name": "发送原始指令帧",
      "description": "直接向设备下发一帧数据（十六进制）。可用于调试或未映射的功能。",
      "fields": {
        "real_address": {
          "name": "设备地址",
          "description": "realAddress，例如 D4438A6633CF"
        },
        "frame": {
          "name": "完整帧（hex）",
          "description": "含校验字节的完整帧，例如 5a0c010f0000..."
        },
        "device_type": {
          "name": "设备类型",
          "description": "帧头 deviceType，灯具=1，UV=7"
        },
        "cmd": {
          "name": "命令号",
          "description": "帧头 cmd"
        },
        "body": {
          "name": "帧体（hex）",
          "description": "不含帧头与校验的负载"
        },
        "protocol": {
          "name": "协议",
          "description": "90 (0x5A) 或 106 (0x6A)"
        },
        "cmd_type": {
          "name": "命令类型",
          "description": "byte4/byte7，0=普通指令，16(0x10)=设置模式"
        }
      }
    },
    "build_frame": {
      "name": "构造指令帧",
      "description": "只计算帧内容并返回十六进制，不发送。",
      "fields": {
        "device_type": {
          "name": "设备类型"
        },
        "cmd": {
          "name": "命令号"
        },
        "body": {
          "name": "帧体（hex）"
        },
        "protocol": {
          "name": "协议"
        },
        "cmd_type": {
          "name": "命令类型",
          "description": "byte4/byte7，0=普通指令，16(0x10)=设置模式"
        }
      }
    }
  }
